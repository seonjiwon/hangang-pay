# hangang-pay-bank deploy/.env 템플릿 (실제 .env는 커밋 금지)
# 온프레미스 수동 배포: 이 파일을 .env로 복사해 값을 채운다.
#   docker build -t hangang-pay-bank:local ..   # (레포 루트에서 빌드)
#   cd deploy && cp .env.example .env && vi .env && docker compose up -d

# --- 앱 이미지 ---
APP_IMAGE=hangang-pay-bank:local

# --- 앱 런타임 ---
SPRING_PROFILES_ACTIVE=prod
DB_URL=
DB_USERNAME=
DB_PASSWORD=
WALLET_KEY_CIPHER_SECRET=
# Besu RPC 엔드포인트 — 미설정 시 localhost:18545. 새 OpenStack Besu(Tailscale IP)로 채운다. 예) BOK_RPC_ENDPOINT=http://100.x.y.z:18545
BOK_RPC_ENDPOINT=
WR_RPC_ENDPOINT=
SH_RPC_ENDPOINT=
HN_RPC_ENDPOINT=

# --- RabbitMQ ---
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# --- Sentry (크리덴셜) ---
SENTRY_DSN=
SENTRY_RELEASE=

# --- Grafana Cloud (크리덴셜) ---
GRAFANA_PROM_URL=
GRAFANA_PROM_USER=
GRAFANA_PROM_PASSWORD=
GRAFANA_LOKI_URL=
GRAFANA_LOKI_USER=
GRAFANA_LOKI_PASSWORD=

# --- Alloy 라벨/타겟 (비밀 아님) ---
ALLOY_SERVICE=hangang-pay-bank
DEPLOY_TARGET=onprem
ALLOY_ENV=prod
ALLOY_COLOR=
APP_SCRAPE_TARGET=app:8081   # compose 서비스명 기준 (container_name과 무관)
APP_CONTAINER_NAME=bank-app  # 로그 필터용 컨테이너명 (compose container_name과 일치)
INSTANCE_ID=        # hostname 등으로 채움
