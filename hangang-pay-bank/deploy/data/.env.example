# hp-data 데이터 인프라(.env). 실제 .env는 커밋 금지.
#   cp .env.example .env && vi .env && docker compose up -d

# --- MySQL (bank DB) ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=hangang_pay_bank

# --- RabbitMQ ---
RABBITMQ_USER=
RABBITMQ_PASS=

# --- Redis ---
# 현재 무인증(내부망 전용). bank에 Redis 붙일 때 requirepass 도입 검토.
